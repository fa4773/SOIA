#!/bin/sh
# ==============================================================================
# SOIA OS - Wayland Kiosk Autostart Session
# Runs in foreground inside cage (or labwc) so the Wayland session stays alive.
# ==============================================================================

# Set Wayland and Chromium/Electron environment variables
export XDG_CURRENT_DESKTOP=SOIA
export XDG_SESSION_TYPE=wayland
export GDK_BACKEND=wayland
export QT_QPA_PLATFORM=wayland
export ELECTRON_OZONE_PLATFORM_HINT=auto
export MOZ_ENABLE_WAYLAND=1

# Initialize persistence if present
if [ -x /usr/local/bin/setup-persistence.sh ]; then
    /usr/local/bin/setup-persistence.sh >/tmp/soia-persistence.log 2>&1 &
fi

# Start PipeWire audio daemon if available
if command -v pipewire >/dev/null 2>&1; then
    pipewire >/dev/null 2>&1 &
fi
if command -v wireplumber >/dev/null 2>&1; then
    wireplumber >/dev/null 2>&1 &
fi

# Explicit guided installer mode
if grep -q "soia_installer=true" /proc/cmdline 2>/dev/null; then
    exec alacritty -e sudo /usr/local/bin/soia-install.sh
fi

# Extra Electron flags for reliable Live USB / Safe Graphics startup
ELECTRON_FLAGS="--kiosk --ozone-platform-hint=auto --enable-features=UseOzonePlatform,WaylandWindowDecorations --no-sandbox"
if grep -q "nomodeset" /proc/cmdline 2>/dev/null; then
    ELECTRON_FLAGS="$ELECTRON_FLAGS --disable-gpu"
fi

# Launch the main SOIA application in FOREGROUND so cage does not exit immediately
if [ -x /opt/soia/soia ]; then
    exec /opt/soia/soia $ELECTRON_FLAGS
elif [ -x /opt/soia/node_modules/.bin/electron ]; then
    cd /opt/soia || exit 1
    exec /opt/soia/node_modules/.bin/electron /opt/soia $ELECTRON_FLAGS
elif [ -d /opt/soia ]; then
    cd /opt/soia || exit 1
    exec npx --no-install electron /opt/soia $ELECTRON_FLAGS
fi

# Fallback terminal if SOIA binary is missing or fails to launch
echo "[SOIA] Application binary not found in /opt/soia. Opening fallback terminal..." >&2
exec alacritty
